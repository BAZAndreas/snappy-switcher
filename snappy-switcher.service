[Unit]
Description=Snappy Switcher - Alt+Tab Window Switcher for Hyprland
Documentation=https://github.com/OpalAayan/snappy-switcher
After=graphical-session.target
PartOf=graphical-session.target
# Ensures the service only attempts to start if a Wayland session is active
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
# Updated to the standard package manager binary path
ExecStart=/usr/bin/snappy-switcher --daemon
Restart=on-failure
RestartSec=1
# Keep restarting during startup until compositor is ready
StartLimitIntervalSec=60
StartLimitBurst=30

[Install]
WantedBy=graphical-session.target
